# ---- Supabase (App Travluin data + auth foundation) ----
# Copy this file to `.env.local` and fill in the values from your Supabase project
# (Project Settings → API). NEVER commit real keys.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key (safe for the browser; row-level security enforces access)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — used ONLY by local tooling to run the seed against a remote
# project (never referenced by app code, never sent to the browser). Optional.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Travel providers (optional; default to the built-in mock adapters) ----
# Set to "amadeus" AND provide credentials to switch off the mock. Without
# credentials the app keeps using the mock so nothing breaks.
HOTEL_PROVIDER=mock
FLIGHT_PROVIDER=mock
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# ---- Currency rates (optional) ----
# exchangerate.host-compatible endpoint (base=SAR). If unset, a maintained
# fallback rates table is used so the converter always works.
RATES_API_URL=

# ---- Hotel supplier credential vault (REQUIRED for supplier settings) ----
# 32-byte key, base64. Encrypts supplier credentials at rest (AES-256-GCM) so
# plaintext secrets are never stored. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key makes previously-stored credentials undecryptable (re-enter them).
SETTINGS_ENCRYPTION_KEY=

# ---- TBO hotel API (optional; machine-to-machine XML/API, NO OTP) ----
# Credentials are entered/encrypted via Settings → "ربط مزوّدي الفنادق", NOT here.
# Set TBO_LIVE=1 only when a real TBO endpoint is reachable; otherwise the adapter
# simulates auth + search against stored credentials (no live network call).
TBO_LIVE=

# Teletel (Chatwoot-compatible) customer platform — server-only, optional.
TELETEL_BASE_URL=
TELETEL_API_TOKEN=
TELETEL_ACCOUNT_ID=1

# Telegram Mini App — bot token from BotFather; server-only, optional.
TELEGRAM_WEBAPP_BOT_TOKEN=

# ---- Ready-made seasonal offers («العروض الجاهزة») ----
# Marketing's offers spreadsheet, read as CSV by the sync button on
# /ready-offers. The sheet must stay shared as "anyone with the link can view";
# the defaults below point at the current summer sheet, so these are only needed
# when marketing moves to a new file or renames the tabs.
READY_OFFERS_SHEET_ID=
READY_OFFERS_GID_ECONOMY=
READY_OFFERS_GID_PREMIUM=

# ---- Daily-program assistants (both optional; each degrades cleanly) ----
# OpenAI — drafts the day-by-day program text ONLY (titles + activities). It
# never writes dates, prices, hotels or flight times. Without a key the button
# is hidden and agents write the days by hand, exactly as before.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# AviationStack — fills a flight row from its number ("SV820"). Real published
# schedules only; the agent confirms every result. Without a key the "fetch
# flight" button is hidden. Defaults to HTTPS (the key rides in the query
# string); set the base URL only if your plan is http-only.
AVIATIONSTACK_API_KEY=
AVIATIONSTACK_BASE_URL=

# Per-day weather uses Open-Meteo, which needs NO key and no configuration.

# ---- «قسم العمليات» Telegram app (bot + Mini App) ----
# Create the bot in @BotFather, then paste its token here and in the server .env.
# Without it the ops bot simply does not answer; nothing else changes.
TELEGRAM_OPS_BOT_TOKEN=
# Optional shared secret Telegram echoes on every update — set it and forged
# webhook calls are rejected.
TELEGRAM_OPS_WEBHOOK_SECRET=
