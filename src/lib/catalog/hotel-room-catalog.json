  "room_rules_ar": [
    "Double تعني غرفة بسرير مزدوج؛ Twin غرفة بسريرين منفصلين. لا تعتبرهما مترادفين.",
    "Triple وQuadruple تصفان السعة؛ لا تستنتج ثلاثة أو أربعة أسرّة من الاسم.",
    "كل عنصر في bed_groups يمثل ترتيبًا بديلًا كاملًا؛ الأسرّة داخل beds في العنصر نفسه مجتمعة. لا تجمع أسرّة البدائل كأنها كلها موجودة.",
    "اختر bed_configuration_status من guaranteed أو on_request أو unspecified. لا تحول التفضيل إلى ضمان.",
    "غرفة Double or Twin تبقى بهذا الاسم إذا لم يُضمن ترتيب محدد. يمكن عرض التفضيل ضمن ملاحظة منفصلة.",
    "لا تستنتج مقاس السرير بالسنتيمتر من اسمه.",
    "عدد غرف النوم مستقل عن عدد الغرف المحجوزة وعدد الأسرّة وعدد النزلاء.",
    "فئة Club لا تضمن دخول الصالة؛ أضف club_lounge_access فقط إذا كان مشمولًا ومؤكدًا.",
    "Connecting لا تعني Adjacent. اختر connecting_status من confirmed أو on_request أو not_applicable وأظهر حالة الطلب.",
    "الإطلالة غير المعروفة تحفظ كقائمة فارغة؛ لا تحولها إلى no_view.",
    "لا تفترض وجود غرفة معيشة منفصلة في كل جناح أو تجهيزات إتاحة محددة بمجرد الاسم.",
    "احفظ الوجبات والسعر وسياسة الإلغاء في خطة السعر المرتبطة بالغرفة، وليس في room_type_id.",
    "الخصائص غير المدعومة في بيانات الفندق لا تضاف إلى الاسم تلقائيًا."
  ],
  "room_name_export": {
    "strategy": "verified_custom_name_else_structured_segments",
    "custom_name_policy_ar": "إذا كانت للغرفة تسمية تجارية مخصصة، استخدم النسخة المعتمدة باللغة المطلوبة؛ عند غيابها أوقف التصدير النهائي حتى اعتمادها، ولا تستبدلها بصمت باسم عام.",
    "structured_name_strategy": "base_label_then_optional_labeled_segments",
    "separator": " | ",
    "base_label_source": "catalogs.room_types[id].label[locale]",
    "segments_order": [
      "category",
      "suite_subtype",
      "bedroom_count",
      "beds",
      "views",
      "features"
    ],
    "field_labels": {
      "ar": {
        "category": "الفئة",
        "suite_subtype": "نوع الجناح",
        "bedroom_count": "عدد غرف النوم",
        "beds": "الأسرّة",
        "views": "الإطلالة",
        "features": "المميزات"
      },
      "en": {
        "category": "Category",
        "suite_subtype": "Suite Type",
        "bedroom_count": "Bedrooms",
        "beds": "Beds",
        "views": "View",
        "features": "Features"
      }
    },
    "list_separator": {
      "ar": "، ",
      "en": ", "
    },
    "bed_item_template": "{quantity} × {localized_bed_type}",
    "alternative_bed_group_separator": {
      "ar": " أو ",
      "en": " OR "
    },
    "bed_status_suffix": {
      "guaranteed": {
        "ar": "مضمون",
        "en": "Guaranteed"
      },
      "on_request": {
        "ar": "حسب الطلب وغير مضمون",
        "en": "On Request, Not Guaranteed"
      },
