{
  "format": "hotel_room_localization_configuration",
  "version": "1.0.0",
  "created_on": "2026-10-15",
  "title_ar": "دليل الغرف الفندقية والإدخال العربي والتصدير حسب الوجهة",
  "purpose_ar": "ملف بيانات ومواصفات للمطور لدمجه في النظام؛ لا ينفذ الترجمة أو التصدير بنفسه.",
  "standards_note_ar": "المسميات شائعة في أنظمة الحجز وليست معيارًا عالميًا ملزمًا. المعرّفات داخل هذا الملف داخلية ولا تمثل أكواد Booking.com أو Expedia. فئات الغرف التجارية ليست ترتيبًا موحدًا بين الفنادق.",
  "ui": {
    "locale": "ar",
    "direction": "rtl",
    "supported_export_locales": [
      "ar",
      "en"
    ],
    "selection_label_path": "label.ar",
    "persist_selection_as": "id",
    "input_policy_ar": "يعرض الموظف الخيارات بالعربية ويحفظ النظام معرّفات ثابتة. إدخال الفندق بالعربية يبحث في دليل الفنادق ثنائي اللغة. اسم الفندق الإنكليزي الرسمي يدخل مرة واحدة ويُراجع؛ لا يمكن ضمان استخراجه من العربية وحدها.",
    "export_language_options": [
      {
        "id": "auto",
        "label": {
          "ar": "تلقائي حسب الوجهة",
          "en": "Automatic by Destination"
        }
      },
      {
        "id": "ar",
        "label": {
          "ar": "العربية",
          "en": "Arabic"
        }
      },
      {
        "id": "en",
        "label": {
          "ar": "الإنكليزية",
          "en": "English"
        }
      }
    ],
    "fields": [
      {
        "key": "hotel_id",
        "label_ar": "الفندق",
        "type": "searchable_hotel_select",
        "required": true,
        "search_fields": [
          "names.ar",
          "names.en",
          "aliases.ar",
          "aliases.en"
        ],
        "match_policy": "select_confirmed_hotel_id",
        "ambiguous_match_action": "require_employee_selection"
      },
      {
        "key": "hotel_country_code",
        "label_ar": "دولة الفندق",
        "type": "country_select",
        "required": true,
        "source": "selected_hotel.country_code"
      },
      {
        "key": "room_type_id",
        "label_ar": "نوع الغرفة",
        "type": "select",
        "catalog": "room_types",
        "required": true
      },
      {
        "key": "room_category_id",
        "label_ar": "فئة الغرفة",
        "type": "select",
        "catalog": "room_categories",
        "required": false
      },
      {
        "key": "suite_subtype_id",
        "label_ar": "نوع الجناح",
        "type": "select",
        "catalog": "suite_subtypes",
        "visible_when": {
          "room_type_id": "suite"
        },
        "required": false
      },
      {
        "key": "bedroom_count",
        "label_ar": "عدد غرف النوم",
        "type": "integer",
        "minimum": 1,
        "nullable": true,
        "required": false
      },
      {
        "key": "bed_groups",
        "label_ar": "ترتيب الأسرّة",
        "type": "bed_groups_editor",
        "catalog": "bed_types",
        "required": false
      },
      {
        "key": "view_ids",
        "label_ar": "الإطلالة",
        "type": "multi_select",
        "catalog": "views",
        "required": false
      },
      {
        "key": "feature_ids",
        "label_ar": "المميزات",
        "type": "multi_select",
        "catalog": "features",
        "required": false
      },
      {
        "key": "max_guests",
        "label_ar": "الحد الأقصى للنزلاء",
        "type": "integer",
        "minimum": 1,
        "required": true
      },
      {
        "key": "max_adults",
        "label_ar": "الحد الأقصى للبالغين",
        "type": "integer",
        "minimum": 0,
        "required": true
      },
      {
        "key": "max_children",
        "label_ar": "الحد الأقصى للأطفال",
        "type": "integer",
        "minimum": 0,
        "required": true
      },
      {
        "key": "export_locale",
        "label_ar": "لغة التصدير",
        "type": "select",
        "options": [
          "auto",
          "ar",
          "en"
        ],
        "default": "auto"
      },
      {
        "key": "custom_room_name",
        "label_ar": "اسم الغرفة الخاص بالفندق",
        "type": "localized_text",
        "required": false,
        "help_ar": "للأسماء التجارية أو الغرف غير الموجودة في القوائم؛ يلزم اعتماد النسخة المطلوبة للتصدير."
      }
    ]
  },
  "destination_language_policy": {
    "mode": "per_stay",
    "default_export_locale": "en",
    "country_code_format": "ISO 3166-1 alpha-2",
    "precedence": [
      "explicit_document_locale",
      "explicit_stay_locale",
      "hotel_export_locale_override",
      "destination_country_overrides",
      "default_export_locale"
    ],
    "automatic_country_source": "stay.hotel.country_code",
    "destination_country_overrides": {
      "IQ": "ar",
      "SA": "ar",
      "AE": "ar",
      "OM": "ar",
      "QA": "ar",
      "KW": "ar",
      "BH": "ar",
      "JO": "ar",
      "EG": "ar",
      "LB": "ar",
      "GE": "en",
      "TR": "en",
      "MY": "en",
      "ID": "en",
      "TH": "en",
      "AZ": "en"
    },
    "editable": true,
    "notes_ar": [
      "القيم افتراضية مقترحة قابلة للتعديل، وليست متطلبات رسمية للدول أو الفنادق.",
      "auto تعني متابعة البحث في ترتيب الأولوية، أما ar أو en فتحسم اللغة.",
      "الوجهة هنا دولة الفندق في كل إقامة، وليس بلد مطار الوصول أو جنسية العميل أو لغة الموظف.",
      "رحلة تصل إلى طرابزون وتقيم في باتومي تستخدم دولة الفندق GE. فندق ريزا يستخدم TR. فندق بالي يستخدم ID حتى لو كان الوصول الدولي إلى ماليزيا.",
      "في الرحلات متعددة البلدان يُحسب القرار لكل إقامة؛ يمكن فرض لغة موحدة للمستند بتعيين explicit_document_locale.",
      "تغيير لغة التصدير لا يغير لغة واجهة الإدخال العربية."
    ]
  },
