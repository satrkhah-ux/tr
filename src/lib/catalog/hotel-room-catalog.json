        "ar": "ترتيب الأسرّة غير مؤكد",
        "en": "Bed Configuration Unconfirmed"
      }
    },
    "omit_empty_segments": true,
    "number_format": "Latin digits",
    "explanation_ar": "استخدم فواصل وتسميات واضحة لتجنب تركيب عربي أو إنكليزي غير سليم. مثال: Double Room | Category: Deluxe | Beds: 1 × King Bed (Guaranteed) | View: Sea View. الاسم التسويقي السلس يمكن حفظه كاسم مخصص معتمد مثل Deluxe King Room with Sea View."
  },
  "validation_rules": [
    {
      "id": "known_ids",
      "severity": "error",
      "rule_ar": "كل معرّف نوع أو فئة أو سرير أو إطلالة أو ميزة يجب أن يوجد في قاموسه؛ لا تعتمد نصًا حرًا كمعرّف."
    },
    {
      "id": "hotel_identity",
      "severity": "error",
      "rule_ar": "معرّف الفندق في الإقامة والغرفة متطابق، ودولة الوجهة مأخوذة من سجل الفندق."
    },
    {
      "id": "hotel_name",
      "severity": "error",
      "rule_ar": "التصدير النهائي يتطلب اسم الفندق المعتمد باللغة المحددة؛ لا تبدّل إلى العربية بصمت في تصدير إنكليزي."
    },
    {
      "id": "occupancy",
      "severity": "error",
      "rule_ar": "قيم السعة أعداد صحيحة؛ max_guests >= 1 وmax_adults وmax_children >= 0، وكل منهما <= max_guests، وmax_guests <= max_adults + max_children. قيّم أعمار الأطفال وفق سياسة الفندق."
    },
    {
      "id": "bed_groups",
      "severity": "error",
      "rule_ar": "كميات الأسرّة أعداد صحيحة موجبة؛ selected_bed_group_id إن وجد يشير إلى أحد البدائل. لا تثبت البديل كتأكيد دون guaranteed."
    },
    {
      "id": "mutually_exclusive_features",
      "severity": "error",
      "rule_ar": "لا تجمع smoking وnon_smoking."
    },
    {
      "id": "views",
      "severity": "error",
      "rule_ar": "no_view لا يجتمع مع أي إطلالة أخرى؛ sea وpartial_sea لا يجتمعان في الوصف نفسه."
    },
    {
      "id": "suite_subtype",
      "severity": "error",
      "rule_ar": "suite_subtype_id يستخدم فقط إذا كان room_type_id هو suite؛ امنع تكرار executive كفئة ونوع جناح في الاسم الناتج."
    },
    {
      "id": "bedroom_count",
      "severity": "error",
      "rule_ar": "عدد غرف النوم إن أُدخل عدد صحيح موجب موثق؛ لا يُستنتج من Single أوDouble أوTriple."
    },
    {
      "id": "connecting",
      "severity": "error",
      "rule_ar": "عند وجود connecting يلزم confirmed أو on_request؛ عند on_request تظهر عبارة حسب الطلب وغير مضمون."
    },
    {
      "id": "double_twin_consistency",
      "severity": "error",
      "rule_ar": "إذا كان النوع twin وترتيب السرير المضمون يخالف سريرين منفصلين، أو كان النوع double يخالف سريرًا مزدوجًا مناسبًا، يجب تصحيح التصنيف أو البيانات قبل التصدير."
    }
  ],
  "export_contract": {
    "input": {
      "document_locale": "auto | ar | en",
      "stay_locale": "auto | ar | en",
      "hotel": "hotel_record",
      "room": "room_record"
    },
    "output": {
      "hotel_id": "string",
      "room_id": "string",
      "destination_country_code": "string",
      "resolved_locale": "ar | en",
      "hotel_name": "string",
      "room_name": "string",
      "bed_configuration_note": "string or null",
      "connection_note": "string or null",
      "max_guests": "integer",
      "warnings": "array"
    },
    "steps_ar": [
      "تحقق من ربط الفندق والغرفة وصحة المعرفات والسعات.",
      "حدد اللغة وفق ترتيب الأولوية؛ تجاهل auto وnull والقيم الفارغة عند فحص التجاوزات.",
      "استخدم دولة الفندق لكل إقامة لتطبيق قواعد الوجهة، ثم اللغة الافتراضية إن لم توجد قاعدة.",
      "اجلب اسم الفندق المعتمد باللغة المطلوبة، وإلا أعد خطأ HOTEL_NAME_TRANSLATION_REQUIRED.",
      "إذا وجد اسم غرفة مخصص بأي لغة فتأكد من وجود نسخته المعتمدة باللغة المطلوبة، وإلا أعد ROOM_NAME_TRANSLATION_REQUIRED.",
      "عند عدم وجود اسم مخصص ابنِ الاسم من المسميات المترجمة والحقول غير الفارغة وفق room_name_export.",
      "أظهر قيود الأسرّة والغرف المتصلة ضمن ملاحظات واضحة حتى عندما تستخدم اسم غرفة مخصصًا.",
      "صدّر الاسم الناتج إلى PDF أو القسيمة أو العرض أو Excel أو واجهة الربط التي ينفذها النظام."
    ],
    "errors": {
      "HOTEL_NAME_TRANSLATION_REQUIRED": "أدخل واعتمد اسم الفندق باللغة المطلوبة قبل التصدير.",
      "ROOM_NAME_TRANSLATION_REQUIRED": "أدخل واعتمد اسم الغرفة المخصص باللغة المطلوبة قبل التصدير.",
      "INVALID_ROOM_CONFIGURATION": "راجع بيانات الغرفة؛ توجد حقول متعارضة أو غير مكتملة."
    }
  },
  "examples_note_ar": "جميع أسماء الفنادق التالية افتراضية لتوضيح السلوك، وليست أسماء منشآت موثقة.",
